@model List<CinemaSite.Models.FaqItem>
@{ ViewData["Title"]="Управление FAQ"; }
<section class="page-hero"><span class="eyebrow">АДМИНИСТРАТИВНАЯ ПАНЕЛЬ</span><h1>ВОПРОСЫ И <em>ОТВЕТЫ</em></h1><p>@TempData["Message"]</p></section><section class="section admin-section"><nav class="admin-nav"><a asp-action="Index">Обзор</a><a asp-action="Films">Фильмы</a><a asp-action="Screenings">Расписание</a><a asp-action="Users">Пользователи</a><a asp-action="Reviews">Отзывы</a><a asp-action="Messages">Контакты</a><a asp-action="Faq">FAQ</a></nav><form asp-action="SaveFaq" method="post" class="admin-form"><h2>ДОБАВИТЬ <em>ВОПРОС</em></h2><input name="Question" placeholder="Вопрос" maxlength="250" required/><textarea name="Answer" placeholder="Ответ" maxlength="2000" required></textarea><button class="button button-primary" type="submit">Добавить вопрос</button></form>@foreach(var faq in Model){<details class="film-edit"><summary>@faq.Question · @(faq.IsActive?"Опубликован":"Скрыт")</summary>@if(faq.IsActive){<form asp-action="SaveFaq" method="post" class="admin-form"><input type="hidden" name="Id" value="@faq.Id"/><input name="Question" value="@faq.Question" maxlength="250" required/><textarea name="Answer" maxlength="2000" required>@faq.Answer</textarea><button class="button button-primary" type="submit">Сохранить</button></form><form asp-action="ArchiveFaq" method="post"><input type="hidden" name="id" value="@faq.Id"/><button class="button button-outline" type="submit">Скрыть</button></form>}</details>}</section>
