@model CinemaSite.Models.AdminScreeningsViewModel
@{
    ViewData["Title"]="Расписание сеансов";
}
<section class="page-hero">
    <span class="eyebrow">АДМИНИСТРАТИВНАЯ ПАНЕЛЬ</span>
    <h1>
        УПРАВЛЕНИЕ
        <em>РАСПИСАНИЕМ</em>
    </h1>
    <p>
        @TempData["Message"]
    </p>
</section>
<section class="section admin-section">
    <nav class="admin-nav">
        <a asp-action="Index">Обзор</a>
        <a asp-action="Films">Фильмы</a>
        <a asp-action="Screenings">Расписание</a>
        <a asp-action="Users">Пользователи</a>
        <a asp-action="Reviews">Отзывы</a>
        <a asp-action="Messages">Обратная связь</a>
    </nav>
    <form asp-action="SaveScreening" method="post" class="admin-form">
        <h2>
            ДОБАВИТЬ
            <em>СЕАНС</em>
        </h2>
        <label>
            Фильм
            <select name="FilmId">
                @foreach (var film in Model.Films)
                {
                    <option value="@film.Id">
                        @film.Title
                    </option>
                }
            </select>
        </label>
        <label>
            Зал
            <select name="Hall">
                <option>
                    Синий
                </option>
                <option>
                    Красный
                </option>
                <option>
                    Зелёный
                </option>
                <option>
                    Оранжевый
                </option>
            </select>
        </label>
        <label>
            Дата и время
            <input type="datetime-local" name="StartsAt" min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required/>
        </label>
        <label>
            Цена билета
            <input type="number" name="TicketPrice" value="450" min="1"/>
        </label>
        <button class="button button-primary" type="submit">
            Добавить сеанс ↗
        </button>
    </form>
    <div class="admin-table">
        @foreach (var session in Model.Screenings)
        {
            <details class="film-edit">
                <summary>
                    @Model.Films.FirstOrDefault(f=>f.Id==session.FilmId)?.Title · @session.StartsAt.ToString("dd.MM.yyyy HH:mm") · @session.Hall зал · @(session.IsActive?"Активен":"Скрыт")
                </summary>
                @if (session.IsActive)
                {
                    <form asp-action="SaveScreening" method="post" class="admin-form">
                        <input type="hidden" name="Id" value="@session.Id"/>
                        <label>
                            Фильм
                            <select name="FilmId">
                                @foreach (var film in Model.Films)
                                {
                                    <option value="@film.Id" selected="@(film.Id==session.FilmId)">
                                        @film.Title
                                    </option>
                                }
                            </select>
                        </label>
                        <label>
                            Зал
                            <select name="Hall">
                                <option selected="@(session.Hall=="Синий")">
                                    Синий
                                </option>
                                <option selected="@(session.Hall=="Красный")">
                                    Красный
                                </option>
                                <option selected="@(session.Hall=="Зелёный")">
                                    Зелёный
                                </option>
                                <option selected="@(session.Hall=="Оранжевый")">
                                    Оранжевый
                                </option>
                            </select>
                        </label>
                        <label>
                            Дата и время
                            <input type="datetime-local" name="StartsAt" value="@session.StartsAt.ToString("yyyy-MM-ddTHH:mm")" required/>
                        </label>
                        <label>
                            Цена билета
                            <input type="number" name="TicketPrice" value="@session.TicketPrice" min="1"/>
                        </label>
                        <button class="button button-primary" type="submit">
                            Сохранить изменения
                        </button>
                    </form>
                    <form asp-action="ArchiveScreening" method="post">
                        <input type="hidden" name="id" value="@session.Id"/>
                        <button class="button button-outline" type="submit">
                            Снять с расписания
                        </button>
                    </form>
                }
            </details>
        }
    </div>
</section>
