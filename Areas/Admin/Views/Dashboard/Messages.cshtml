@model CinemaSite.Models.AdminMessagesViewModel
@{ ViewData["Title"]="Обратная связь"; }
<section class="page-hero"><span class="eyebrow">АДМИНИСТРАТИВНАЯ ПАНЕЛЬ</span><h1>СООБЩЕНИЯ <em>ПОСЕТИТЕЛЕЙ</em></h1><p>@TempData["Message"]</p></section><section class="section admin-section"><nav class="admin-nav"><a asp-action="Index">Обзор</a><a asp-action="Reviews">Отзывы</a><a asp-action="Messages">Обратная связь</a>@if(User.IsInRole("Admin")){<a asp-action="Films">Фильмы</a><a asp-action="Screenings">Расписание</a><a asp-action="Users">Пользователи</a>}</nav>@if(User.IsInRole("Admin")){<form asp-action="SaveSettings" method="post" class="admin-form"><h2>КОНТАКТЫ И <em>НАСТРОЙКИ</em></h2><label>Название<input name="CinemaName" value="@Model.Settings.CinemaName" required/></label><label>Адрес<input name="Address" value="@Model.Settings.Address" required/></label><label>Телефон<input name="Phone" value="@Model.Settings.Phone" required/></label><label>Почта<input name="Email" value="@Model.Settings.Email" required/></label><label>Часы работы<input name="OpeningHours" value="@Model.Settings.OpeningHours" required/></label><button class="button button-primary" type="submit">Сохранить настройки</button></form>}<div class="admin-table">@foreach(var message in Model.Messages){<article class="message-card"><div class="booking-bottom"><strong>@message.Name · @message.Email</strong><span>@message.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @(message.IsRead?"Прочитано":"Новое")</span></div><p>@message.Message</p>@if(!message.IsRead){<form asp-action="MarkMessageRead" method="post"><input type="hidden" name="id" value="@message.Id"/><button class="button button-outline" type="submit">Отметить прочитанным</button></form>}</article>}</div></section>
