@model CinemaSite.Models.AdminDashboardViewModel
@{
    ViewData["Title"]="Панель управления";
}
<section class="page-hero">
    <span class="eyebrow">АДМИНИСТРАТИВНАЯ ПАНЕЛЬ · @User.Identity?.Name</span>
    <h1>
        УПРАВЛЕНИЕ
        <em>КИНОТЕАТРОМ</em>
    </h1>
    <p>
        Сводка по сайту, бронированиям и отзывам.
    </p>
</section>
<section class="section admin-section">
    <nav class="admin-nav">
        <a asp-action="Index">Обзор</a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Films">Фильмы</a>
            <a asp-action="Screenings">Расписание</a>
            <a asp-action="Users">Пользователи</a>
            <a asp-action="Faq">FAQ</a>
            <a asp-action="Messages">Обратная связь</a>
        }
        <a asp-action="Reviews">Отзывы</a>
    </nav>
    <div class="stats-grid">
        <div>
            <span>АКТИВНЫЕ ФИЛЬМЫ</span>
            <b>@Model.Films</b>
        </div>
        <div>
            <span>БЛИЖАЙШИЕ СЕАНСЫ</span>
            <b>@Model.Screenings</b>
        </div>
        <div>
            <span>БРОНИРОВАНИЯ</span>
            <b>@Model.Bookings</b>
        </div>
        <div>
            <span>ЖДУТ МОДЕРАЦИИ</span>
            <b>@Model.Reviews</b>
        </div>
        <div>
            <span>ПОЛЬЗОВАТЕЛИ</span>
            <b>@Model.Users</b>
        </div>
    </div>
    <h2>
        ПОСЛЕДНИЕ
        <em>БРОНИ</em>
    </h2>
    <div class="admin-table">
        <div class="admin-row admin-head">
            <span>Заказ</span>
            <span>Посетитель</span>
            <span>Сеанс</span>
            <span>Места</span>
            <span>Сумма / статус</span>
            <span></span>
        </div>
        @foreach (var item in Model.Items)
        {
            <div class="admin-row">
                <span>@item.Booking.Id[..8]</span>
                <span>@item.User?.Name</span>
                <span>@item.Film?.Title<br />@item.Screening?.StartsAt.ToString("dd.MM HH:mm") · @item.Screening?.Hall</span>
                <span>@string.Join(", ",item.Booking.Seats)</span>
                <span>@item.Booking.Total ₽<br />@item.Booking.Status</span>
                <span>
                    <form asp-action="UpdateBooking" method="post">
                        <input type="hidden" name="id" value="@item.Booking.Id"/>
                        <select name="status">
                            <option>
                                Ожидает оплаты
                            </option>
                            <option>
                                Оплачено
                            </option>
                            <option>
                                Отменено
                            </option>
                        </select>
                        <button class="button button-outline" type="submit">
                            Обновить
                        </button>
                    </form>
                </span>
            </div>
        }
    </div>
</section>
