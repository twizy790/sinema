@model List<CinemaSite.Models.AccountBookingViewModel>
@{ ViewData["Title"] = "Мои бронирования"; }
<section class="page-hero"><span class="eyebrow">ЛИЧНЫЙ КАБИНЕТ</span><h1>МОИ <em>БИЛЕТЫ</em></h1><p>@TempData["Message"] @TempData["BookingMessage"]</p></section><section class="section">@if (Model.Count == 0) { <p>У вас пока нет бронирований. <a asp-controller="Home" asp-action="Schedule">Выбрать сеанс ↗</a></p> } else { foreach (var item in Model) { <article class="booking-item"><div><h3>@item.Film?.Title</h3><p>@item.Screening?.StartsAt.ToString("dd.MM.yyyy HH:mm") · @item.Screening?.Hall зал · места @string.Join(", ", item.Booking.Seats)</p><p>@item.Booking.Total ₽ · <strong>@item.Booking.Status</strong></p></div>@if (item.Booking.Status == "Ожидает оплаты") { <form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@item.Booking.Id" /><button class="button button-outline" type="submit">Отменить</button></form> }</article> } }</section>
