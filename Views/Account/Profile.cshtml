@model CinemaSite.Models.ProfileInput
@{
    ViewData["Title"]="Профиль";
}
<section class="page-hero">
    <span class="eyebrow">ЛИЧНЫЙ КАБИНЕТ</span>
    <h1>
        МОЙ
        <em>ПРОФИЛЬ</em>
    </h1>
    <p>
        @TempData["Message"]
    </p>
</section>
<section class="account-wrap">
    <div class="account-card">
        <nav class="admin-nav">
            <a asp-action="Bookings">Мои билеты</a>
            <a asp-action="Profile">Настройки профиля</a>
        </nav>
        <form asp-action="Profile" method="post" class="simple-form">
            <div asp-validation-summary="ModelOnly" class="notice"></div>
            <label>
                Имя
                <input asp-for="Name" autocomplete="name"/>
            </label>
            <label>
                Электронная почта
                <input asp-for="Email" autocomplete="email"/>
            </label>
            <label>
                Текущий пароль
                <small>(обязателен для смены пароля)</small>
                <input asp-for="CurrentPassword" type="password" autocomplete="current-password"/>
            </label>
            <label>
                Новый пароль
                <input asp-for="NewPassword" type="password" autocomplete="new-password" placeholder="Оставьте пустым без изменений"/>
            </label>
            <button class="button button-primary" type="submit">
                Сохранить профиль ↗
            </button>
        </form>
    </div>
</section>
