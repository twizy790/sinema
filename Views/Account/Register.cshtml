@model CinemaSite.Models.RegistrationInput
@{ ViewData["Title"] = "Регистрация"; }
<section class="page-hero"><span class="eyebrow">СОЗДАЙТЕ СВОЙ АККАУНТ</span><h1>РЕГИСТРАЦИЯ <em>В СИНЕМА</em></h1></section><section class="account-wrap"><div class="account-card"><form asp-action="Register" method="post" class="simple-form"><div asp-validation-summary="ModelOnly" class="notice"></div><label>Имя<input asp-for="Name" autocomplete="name" /><span asp-validation-for="Name"></span></label><label>Электронная почта<input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></label><label>Пароль<input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password"></span></label><button class="button button-primary" type="submit">Создать аккаунт ↗</button></form><p>Уже зарегистрированы? <a asp-action="Login">Войти</a></p></div></section>
