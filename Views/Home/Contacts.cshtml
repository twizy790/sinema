@model CinemaSite.Models.SiteSettings
@{ ViewData["Title"] = "Контакты"; }
<section class="page-hero"><span class="eyebrow">МЫ РЯДОМ</span><h1>КАК НАС <em>НАЙТИ</em></h1><p>Будем рады видеть вас на ближайшем сеансе.</p></section><section class="section contact-layout"><div><span class="eyebrow">ЗАХОДИТЕ В ГОСТИ</span><h2>@Model.Address.ToUpper()</h2><div class="contact-detail"><span>ТЕЛЕФОН КАССЫ</span><a href="tel:@Model.Phone">@Model.Phone</a></div><div class="contact-detail"><span>ЧАСЫ РАБОТЫ</span><b>@Model.OpeningHours</b></div><div class="contact-detail"><span>ПОЧТА</span><a href="mailto:@Model.Email">@Model.Email</a></div></div><div class="map-card contact-map"><div class="map-lines"></div><span class="map-label">@Model.CinemaName</span><span class="map-pin">✳</span><span class="map-street street-one">УЛ. БАУМАНА</span><span class="map-street street-two">УЛ. ПУШКИНА</span><span class="map-street street-three">КРЕМЛЁВСКАЯ</span></div></section><section class="section contact-form-section"><div><span class="eyebrow">МЫ НА СВЯЗИ</span><h2>ЕСТЬ <em>ВОПРОС?</em></h2><p>Напишите нам, и команда ответит в ближайшее время.</p>@if(TempData["Message"] is string message){<div class="notice">@message</div>}</div><form asp-action="Contacts" method="post" class="simple-form"><label>Ваше имя<input name="Name" required maxlength="80" placeholder="Как к вам обращаться" /></label><label>Электронная почта<input name="Email" type="email" required placeholder="name@example.com" /></label><label>Сообщение<textarea name="Message" rows="4" required minlength="5" maxlength="2000" placeholder="Ваш вопрос"></textarea></label><button class="button button-primary" type="submit">Отправить сообщение <span>↗</span></button></form></section>
