@using CinemaSite.Models
@{
    ViewData["Title"] = "Афиша кино";
    var films=ViewBag.Films as List<Film>??[];
    var screenings=ViewBag.Screenings as List<Screening>??[];
    var selected=ViewBag.SelectedDate is DateTime d?d.Date:DateTime.Today;
}
<section class="page-hero">
    <span class="eyebrow">БОЛЬШИЕ ИСТОРИИ — БЛИЖЕ, ЧЕМ КАЖЕТСЯ</span>
    <h1>
        АФИША
        <em>КИНО</em>
    </h1>
    <p>
        Выберите фильм и удобное время. Сеансы ежедневно с 10:00 до 02:00.
    </p>
</section>
<section class="section schedule-section">
    <div class="date-strip">
        <span class="eyebrow">@selected.ToString("MMMM yyyy").ToUpper()</span>
        <div class="date-list">
            @for (int i=0;i<30;i++)
            {
                var day=DateTime.Today.AddDays(i);
                <a class="date-chip @(day.Date==selected?"active":"")" asp-action="Schedule" asp-route-date="@day.ToString("yyyy-MM-dd")">
                    <small>@day.ToString("ddd").ToUpper()</small>
                    <b>@day.Day</b>
                </a>
            }
        </div>
    </div>
    @if (screenings.Count==0)
    {
        <p>
            На выбранную дату сеансы не найдены.
        </p>
    }
    <div class="schedule-grid">
        @foreach (var film in films)
        {
            var movieSessions=screenings.Where(x=>x.FilmId==film.Id).ToList();
            <article class="schedule-card">
                <div class="schedule-poster" style="background-image:url('/images/posters/@film.Poster')"></div>
                <div class="schedule-details">
                    <div class="film-info">
                        <div>
                            <h3>
                                @film.Title
                            </h3>
                            <p>
                                @film.Genre · @(film.DurationMinutes/60) ч @(film.DurationMinutes%60) мин · @film.AgeRating
                            </p>
                        </div>
                        <span class="rating">★ 8.7</span>
                    </div>
                    <p class="film-description">
                        @film.Description
                    </p>
                    @if (!string.IsNullOrWhiteSpace(film.TrailerUrl))
                    {
                        <a class="text-link" href="@film.TrailerUrl" target="_blank" rel="noopener noreferrer">Смотреть трейлер ↗</a>
                    }
                    @if (movieSessions.Count==0)
                    {
                        <p>
                            Сеансы на эту дату пока не добавлены.
                        </p>
                    }
                    else
                    {
                        @foreach (var group in movieSessions.GroupBy(x=>x.Hall))
                        {
                            <div class="hall-list">
                                <span>@group.Key зал</span>
                                @foreach (var session in group)
                                {
                                    <a asp-action="Booking" asp-route-screeningId="@session.Id">@session.StartsAt.ToString("HH:mm") · @session.TicketPrice ₽</a>
                                }
                            </div>
                        }
                    }
                </div>
            </article>
        }
    </div>
</section>
