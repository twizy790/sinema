@using CinemaSite.Models
@{ ViewData["Title"] = "Кино начинается здесь"; var films=ViewBag.Films as List<Film>??[]; var screenings=ViewBag.Screenings as List<Screening>??[]; var faq=ViewBag.Faq as List<FaqItem>??[]; var settings=ViewBag.Settings as SiteSettings??new SiteSettings(); }
<section class="hero">
    <div class="hero-image" id="hero-image"></div><div class="hero-shade"></div>
    <div class="hero-content"><span class="eyebrow"><span class="live-dot"></span> В ЭТОМ МЕСЯЦЕ · БОЛЬШОЙ ЭКРАН</span><p class="hero-kicker">НЕ ПРОСТО СМОТРЕТЬ</p><h1>ЧУВСТВОВАТЬ<br /><em>КАЖДЫЙ КАДР</em></h1><p class="hero-copy">Истории, которые остаются с вами. Премьеры, любимое кино<br class="desktop-only" /> и тот самый звук, ради которого хочется вернуться.</p><div class="hero-actions"><a class="button button-primary" asp-controller="Home" asp-action="Schedule">Смотреть афишу <span>↗</span></a><a class="play-link" href="#about"><span class="play-icon">↓</span>Открыть кинотеатр</a></div></div>
    <div class="hero-counter"><button class="hero-prev" type="button" aria-label="Предыдущий слайд" title="Предыдущий слайд" aria-controls="hero-image">←</button><span class="hero-current" aria-live="polite">01</span><i></i><span class="hero-total">03</span><button class="hero-next" type="button" aria-label="Следующий слайд" title="Следующий слайд" aria-controls="hero-image">→</button></div><div class="hero-caption">СЕАНСЫ КАЖДЫЙ ДЕНЬ <span>С 10:00 ДО 02:00</span></div>
</section>
<div class="ticker"><span>БОЛЬШОЕ КИНО</span><b>✳</b><span>БОЛЬШИЕ ЭМОЦИИ</span><b>✳</b><span>ВАШЕ МЕСТО В ЗАЛЕ</span><b>✳</b><span>БОЛЬШОЕ КИНО</span></div>
<section class="section film-section" id="schedule"><div class="section-heading"><div><span class="eyebrow">НЕ ПРОПУСТИТЕ</span><h2>СЕГОДНЯ <em>НА ЭКРАНЕ</em></h2></div><a class="text-link" asp-controller="Home" asp-action="Schedule">Вся афиша <span>↗</span></a></div>
    <div class="film-grid">@foreach (var film in films) { var filmScreenings=screenings.Where(x=>x.FilmId==film.Id).OrderBy(x=>x.StartsAt).Take(3).ToList(); <article class="film-card"><a class="poster" asp-controller="Home" asp-action="Booking" style="--poster-accent:#b58458;--poster-image:url('/images/posters/@film.Poster')"><span class="age">@film.AgeRating</span><span class="poster-label">СИНЕМА <i>№01</i></span><span class="poster-title">@film.Title</span><span class="poster-arrow">↗</span></a><div class="film-info"><div><h3>@film.Title</h3><p>@film.Genre · @film.DurationMinutes мин</p></div><span class="rating">★ 8.7</span></div><div class="showtimes">@foreach (var session in filmScreenings) { <a asp-controller="Home" asp-action="Booking" asp-route-screeningId="@session.Id">@session.StartsAt.ToString("HH:mm")</a> }</div></article> }</div>
</section>
<section class="about-band" id="about"><div class="about-image"></div><div class="about-copy"><span class="eyebrow">МЕСТО ДЛЯ ВАШИХ ИСТОРИЙ</span><h2>КОГДА МИР<br />СТАНОВИТСЯ <em>БОЛЬШЕ</em></h2><p>Четыре зала с характером, объёмный звук и кресла, в которых хочется задержаться после титров. Мы создали пространство, где кино становится событием.</p><a class="button button-outline" asp-controller="Home" asp-action="About">Узнать о нас <span>↗</span></a><div class="stat-row"><div><strong>4</strong><span>УНИКАЛЬНЫХ ЗАЛА</span></div><div><strong>4K</strong><span>ЛАЗЕРНАЯ ПРОЕКЦИЯ</span></div><div><strong>Dolby</strong><span>ОБЪЁМНЫЙ ЗВУК</span></div></div></div></section>
<section class="section experience"><div class="section-heading"><div><span class="eyebrow">ВАШ ВЕЧЕР, ВАШИ ПРАВИЛА</span><h2>БОЛЬШЕ, ЧЕМ <em>КИНО</em></h2></div><a class="text-link" asp-controller="Home" asp-action="Services">Все услуги <span>↗</span></a></div><div class="experience-grid"><a class="experience-card exp-food" asp-controller="Home" asp-action="Services"><span class="experience-number">01 / ВКУС</span><strong>ПОП-КОРН<br />И НЕ ТОЛЬКО</strong><span class="experience-cta">МЕНЮ БАРА ↗</span></a><a class="experience-card exp-vip" asp-controller="Home" asp-action="About"><span class="experience-number">02 / КОМФОРТ</span><strong>ВАШ ЛИЧНЫЙ<br />VIP-ЗАЛ</strong><span class="experience-cta">УЗНАТЬ БОЛЬШЕ ↗</span></a><a class="experience-card exp-gift" asp-controller="Home" asp-action="Services"><span class="experience-number">03 / ПОДАРОК</span><strong>ВПЕЧАТЛЕНИЯ<br />В КОНВЕРТЕ</strong><span class="experience-cta">ПОДАРОЧНЫЕ КАРТЫ ↗</span></a></div></section>
<section class="review-band"><span class="eyebrow">ВАШИ СЛОВА — ЛУЧШАЯ РЕКОМЕНДАЦИЯ</span><div class="quote-mark">“</div><blockquote>Это тот редкий случай, когда сам поход в кино становится частью фильма. Звук, свет, кресла — всё на своём месте.</blockquote><div class="quote-author"><span class="avatar">А</span><span>АННА К.<small>БЫЛА НА СЕАНСЕ «ДЮНА 2»</small></span><span class="quote-stars">★★★★★</span></div><a class="text-link" asp-controller="Home" asp-action="Reviews">Читать все отзывы ↗</a></section>
<section class="visit-section"><div><span class="eyebrow">МЫ УЖЕ ЖДЁМ ВАС</span><h2>КИНО НАЧИНАЕТСЯ<br /><em>С ДОРОГИ К НАМ</em></h2><p>@settings.Address<br />@settings.OpeningHours</p><a class="text-link" asp-controller="Home" asp-action="Contacts">Как добраться <span>↗</span></a></div><div class="map-card"><div class="map-lines"></div><span class="map-label">@settings.CinemaName</span><span class="map-pin">✳</span><span class="map-street street-one">УЛ. БАУМАНА</span><span class="map-street street-two">УЛ. ПУШКИНА</span><span class="map-street street-three">КРЕМЛЁВСКАЯ</span><a class="map-open" href="https://yandex.ru/maps/?text=@Uri.EscapeDataString(settings.Address)" target="_blank" rel="noopener noreferrer">Открыть карту ↗</a></div></section>
<section class="faq section"><span class="eyebrow">ПЕРЕД СЕАНСОМ</span><h2>ЧАСТЫЕ <em>ВОПРОСЫ</em></h2>@foreach(var item in faq){<details><summary>@item.Question<span>+</span></summary><p>@item.Answer</p></details>}</section>
